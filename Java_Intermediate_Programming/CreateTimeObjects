class Time {
  // Write your code
  private int hour;
  private int minute; 
  private int second; 

  public Time() {
    setTime(System.currentTimeMillis());
  }
  public Time(int hour, int minute, int second){
    this.hour = hour;
    this.minute = minute;
    this.second = second;
  }
  public Time(long elapsedTime){
    setTime(elapsedTime);
  }
 //getter 
  public int getHour(){
    return hour;
  }
  public int getMinute(){ 
    return minute;
  }
  public int getSecond(){
    return second;
  }
  public void setTime(long elapsedTime) {
    long totalSeconds = elapsedTime / 1000;
    this.second = (int)(totalSeconds % 60);

    long totalMinutes = totalSeconds / 60;
    this.minute = (int)(totalMinutes % 60);

    long totalHours = totalMinutes / 60;
    this.hour = (int)(totalHours % 24);
  }
}
public class Exercise {
  public static void main(String[] args) {
    // Write your code here
    Time time1 = new Time();
    Time time2 = new Time(555550000); 
    Time time3 = new Time(5, 23, 55);

    System.out.println(time1.getHour() + ":" + time1.getMinute() + ":" + time1.getSecond());
    System.out.println(time2.getHour() + ":" + time2.getMinute() + ":" + time2.getSecond());
    System.out.println(time3.getHour() + ":" + time3.getMinute() + ":" + time3.getSecond());
  }
}
